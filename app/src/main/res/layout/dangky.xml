<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Circle Gradient Background Effects -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_circle_gradient" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-70dp"
        android:background="@drawable/bg_circle_gradient" />

    <!-- Nội dung chính -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        tools:context=".activities.DangKyActivity">

        <!-- Icon Logo + ZenTask Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginTop="40dp">

            <ImageView
                android:id="@+id/img_logo_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_logo_app" />

            <TextView
                android:id="@+id/tv_logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:text="ZenTask"
                android:textColor="#2D1B3D"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo Tài Khoản"
            android:textColor="#1F1235"
            android:layout_marginTop="20dp"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Phụ đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng ký để bắt đầu học hiệu quả"
            android:textColor="#8A8A8A"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:textAlignment="center"/>

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#2D1B4E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#9A94A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập email"
                    android:inputType="textEmailAddress"
                    android:textColor="#2D1B4E"
                    android:textColorHint="#B7B3C2"
                    android:textSize="14sp"
                    android:paddingVertical="13dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Tên hiển thị -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvTen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên hiển thị"
                android:textColor="#2D1B4E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTen"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:startIconDrawable="@drawable/icon_ten"
                app:startIconTint="#9A94A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập vào tên hiển thị"
                    android:textColor="#2D1B4E"
                    android:textColorHint="#B7B3C2"
                    android:textSize="14sp"
                    android:paddingVertical="13dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Mật khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvMatKhau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu"
                android:textColor="#2D1B4E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMatKhau"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:startIconDrawable="@drawable/ic_password"
                app:startIconTint="#9A94A8"
                app:endIconMode="password_toggle"
                app:endIconTint="#9A94A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMatKhau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:textColor="#2D1B4E"
                    android:textColorHint="#B7B3C2"
                    android:textSize="14sp"
                    android:paddingVertical="13dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Xác nhận mật khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvXacNhanMatKhau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác nhận mật khẩu"
                android:textColor="#2D1B4E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilXacNhanMatKhau"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:startIconDrawable="@drawable/ic_password"
                app:startIconTint="#9A94A8"
                app:endIconMode="password_toggle"
                app:endIconTint="#9A94A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtXacNhanMatKhau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập lại mật khẩu"
                    android:inputType="textPassword"
                    android:textColor="#2D1B4E"
                    android:textColorHint="#B7B3C2"
                    android:textSize="14sp"
                    android:paddingVertical="13dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Nút Đăng ký -->
        <Button
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:text="Đăng ký"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp"/>

        <!-- Đã có tài khoản? Đăng nhập -->
        <TextView
            android:id="@+id/tvDangNhap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:text="Đã có tài khoản? Đăng nhập"
            android:textColor="#0D0C0C"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
