<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_item_dan_y"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/nen_the_dan_y"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!--Icon dòng kẻ (đại diện 1 mục dàn ý)-->
    <TextView
        android:id="@+id/tv_icon_muc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="☰"
        android:textColor="#9B8AAE"
        android:textSize="16sp">
    </TextView>

    <!--Tiêu đề mục (Chương / mục con)-->
    <TextView
        android:id="@+id/tv_tieu_de"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Chương 1: Giới thiệu"
        android:textColor="#2B1B3D"
        android:textSize="15sp"
        android:textStyle="bold">
    </TextView>

    <!--Badge trạng thái (Toán rời rạc / Cần thêm tài liệu)-->
    <TextView
        android:id="@+id/tv_badge_trang_thai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nen_badge_xam"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Toán rời rạc"
        android:textColor="#63587B"
        android:textSize="11sp">
    </TextView>

</LinearLayout>