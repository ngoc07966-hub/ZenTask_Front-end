<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!--Thanh cuộn nội dung-->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--Tiêu đề trang-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tạo Dàn Ý Bằng AI"
                android:textColor="#2B1B3D"
                android:textSize="24sp"
                android:textStyle="bold">
            </TextView>

            <!--Mô tả ngắn-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AI sẽ tự động lập dàn ý học tập chi tiết từ tài liệu"
                android:textColor="#9B8AAE"
                android:textSize="14sp">
            </TextView>

            <!--Nhóm chọn loại mẫu (Đề án / Ôn thi / Báo cáo / Tự do)-->
            <LinearLayout
                android:id="@+id/ll_loai_mau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/tv_chip_dean"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:minHeight="48dp"
                    android:text="Đề án"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp">
                </TextView>

                <TextView
                    android:id="@+id/tv_chip_onthi"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_dachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:text="Ôn thi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp">
                </TextView>

                <TextView
                    android:id="@+id/tv_chip_baocao"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:minHeight="48dp"
                    android:text="Báo cáo"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp">
                </TextView>

                <TextView
                    android:id="@+id/tv_chip_tudo"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:text="Tự do"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp">
                </TextView>
            </LinearLayout>

            <!--Ô nhập tên môn học / chủ đề-->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_ten_mon_hoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/nen_o_nhap"
                    android:hint="Nhập tên môn học hoặc chủ đề (VD: Toán rời rạc)..."
                    android:inputType="text"
                    android:padding="14dp"
                    android:textColor="#2B1B3D"
                    android:textColorHint="#9B8AAE"
                    android:textSize="14sp">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>

            <!--Khu vực kéo thả / chọn file-->
            <LinearLayout
                android:id="@+id/ll_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/nen_khung_chonfile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="32dp">

                <ImageView
                    android:id="@+id/img_upload_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_taifile">
                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Kéo thả hoặc chọn file PDF, Ảnh"
                    android:textColor="#2B1B3D"
                    android:textStyle="bold"
                    android:textSize="15sp">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hỗ trợ: PDF, JPG, PNG (tối đa 20MB)"
                    android:textColor="#9B8AAE"
                    android:textSize="12sp">
                </TextView>
            </LinearLayout>

            <!--Tên file đã chọn (ẩn mặc định, hiện sau khi chọn file)-->
            <TextView
                android:id="@+id/tv_ten_file_da_chon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#2B1B3D"
                android:textSize="13sp"
                android:visibility="gone">
            </TextView>

            <!--Ghi chú mẹo sử dụng-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/nen_canhbao"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="14sp">
                </TextView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="AI phân tích tốt nhất khi tài liệu rõ chữ, không bị bóng mờ."
                    android:textColor="#B08900"
                    android:textSize="12sp">
                </TextView>
            </LinearLayout>

            <!--Nút xử lý AI-->
            <TextView
                android:id="@+id/btn_xuly_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:text="Xử lý AI ✨"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp">
            </TextView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--Thanh điều hướng-->
    <include
        android:id="@+id/bottom_nav_include"
        layout="@layout/thanhdieuhuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginRight="9dp"
        android:layout_marginLeft="9dp"
        android:layout_marginBottom="9dp">
    </include>

</FrameLayout>