<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!--Thanh cuộn nội dung-->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--Hàng tiêu đề: nút quay lại + tiêu đề trang-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_quay_lai"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/nen_o_nhap"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="#2B1B3D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lên Lịch Học"
                    android:textColor="#2B1B3D"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--Mô tả ngắn-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chọn hạn chót, ZenTask sẽ chia đều bài học mỗi ngày"
                android:textColor="#9B8AAE"
                android:textSize="14sp" />

            <!--Thẻ thông tin môn học-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_banner"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÔN HỌC"
                    android:textColor="#7B3FA0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ten_mon_hoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#2B1B3D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Toán rời rạc" />

                <TextView
                    android:id="@+id/tv_so_muc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#9B8AAE"
                    android:textSize="13sp"
                    tools:text="12 mục trong dàn ý" />
            </LinearLayout>

            <!--Nhãn chọn hạn chót-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hạn chót hoàn thành"
                android:textColor="#2B1B3D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!--Ô chọn ngày: bấm để mở DatePickerDialog-->
            <LinearLayout
                android:id="@+id/ll_chon_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nen_o_nhap"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lichhoc" />

                <TextView
                    android:id="@+id/tv_deadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Chạm để chọn ngày"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#9B8AAE"
                    android:textSize="20sp" />
            </LinearLayout>

            <!--Chip chọn nhanh số ngày (tag = số ngày tính từ hôm nay)-->
            <LinearLayout
                android:id="@+id/ll_chon_nhanh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/tv_chip_3ngay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:tag="3"
                    android:text="3 ngày"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_chip_1tuan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:tag="7"
                    android:text="1 tuần"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_chip_2tuan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:tag="14"
                    android:text="2 tuần"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_chip_1thang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/nen_chip_chuachon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingVertical="10dp"
                    android:tag="30"
                    android:text="1 tháng"
                    android:textColor="#9B8AAE"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--Xem trước khối lượng học (ẩn cho tới khi chọn ngày)-->
            <LinearLayout
                android:id="@+id/ll_xem_truoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/nen_o_nhap"
                android:orientation="horizontal"
                android:paddingVertical="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_so_ngay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7B3FA0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ngày học"
                        android:textColor="#9B8AAE"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E5DEF0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_muc_moi_ngay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7B3FA0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="~2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mục mỗi ngày"
                        android:textColor="#9B8AAE"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!--Ghi chú cách xếp lịch-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/nen_canhbao"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Lịch bắt đầu từ hôm nay. Chỉ các mục chưa có lịch mới được xếp."
                    android:textColor="#B08900"
                    android:textSize="12sp" />
            </LinearLayout>

            <!--Nút xếp lịch-->
            <TextView
                android:id="@+id/btn_xep_lich"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingVertical="16dp"
                android:text="Xếp Lịch Học"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--Thanh điều hướng-->
    <include
        android:id="@+id/bottom_nav_include"
        layout="@layout/thanhdieuhuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="9dp" />

    <!--Lớp phủ loading — đặt CUỐI CÙNG để nằm trên mọi view, clickable=true để chặn chạm xuyên qua-->
    <LinearLayout
        android:id="@+id/ll_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#992B1B3D"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Đang xử lý..."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
