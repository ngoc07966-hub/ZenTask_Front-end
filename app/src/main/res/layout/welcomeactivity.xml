<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!--Circle Gradient-->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_circle_gradient" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-70dp"
        android:background="@drawable/bg_circle_gradient" />

    <!-- nội dung chính-->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".activities.WelcomeActivity">

        <!-- Icon chữ Z + ZenTask -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginTop="40dp">

            <TextView
                android:id="@+id/tv_logo_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_logo_icon"
                android:gravity="center"
                android:text="Z"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:text="ZenTask"
                android:textColor="#2D1B3D"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Icon app trung tâm -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:clipChildren="false">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_gradient" />

            <ImageView
                android:layout_width="159dp"
                android:layout_height="154dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_logo_app" />

        </FrameLayout>

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Học thông minh hơn"
            android:paddingHorizontal="30dp"
            android:textColor="#1F1235"
            android:layout_marginTop="16dp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trợ lý AI giúp bạn lên kế hoạch, tổ chức và chinh phục mọi môn học."
            android:textColor="#8A8A8A"
            android:paddingHorizontal="32dp"
            android:textSize="14sp"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nút chính: Bắt đầu ngay -->
        <Button
            android:id="@+id/btnBatDau"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/btn_primary"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Bắt đầu ngay"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Nút phụ: Đã có tài khoản? Đăng Nhập -->
        <Button
            android:id="@+id/btnlogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_outline"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Đã có tài khoản? Đăng Nhập"
            android:textColor="#2D1B3D"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_weight="1.5" />

    </LinearLayout>

</FrameLayout>